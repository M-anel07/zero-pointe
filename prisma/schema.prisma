datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  output          = "../app/generated/prisma/client"
}

model User {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId // <-- Format MongoDB
  pseudo    String?   @unique
  email     String?   @unique
  mdp       String?
  image     String?   
  depense   Depense[]
  votes     Vote[]
  inscritLe DateTime  @default(now())
}

model Depense {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId // <-- Format MongoDB
  titre    String
  prix     Float
  category String
  userId   String   @db.ObjectId // <-- Format MongoDB
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes    Vote[]
  creerLe  DateTime @default(now())
}

model Vote {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId // <-- Format MongoDB
  type      String  
  userId    String  @db.ObjectId // <-- Format MongoDB
  depenseId String  @db.ObjectId // <-- Format MongoDB
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  depense   Depense @relation(fields: [depenseId], references: [id], onDelete: Cascade)

  @@unique([userId, depenseId])
}